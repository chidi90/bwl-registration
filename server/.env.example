# Port number the Express server listens on (e.g., 5000)
PORT=

# Exact frontend URL allowed to call this backend API (e.g., http://localhost:5173)
CLIENT_URL=

# Supabase project URL from Project Settings -> Data API / API Keys
SUPABASE_URL=

# Supabase secret service_role key (NEVER put in /client or Git)
SUPABASE_SERVICE_ROLE_KEY=

# Max successful registrations allowed per IP per 15-minute window (default 100)
RATE_LIMIT_MAX=